<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/loader_card"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start options"
        android:fontFamily="@font/bold"
        android:textSize="18sp"
        android:includeFontPadding="false"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose an action"
        android:fontFamily="@font/font"
        android:textSize="13sp"
        android:includeFontPadding="false"
        android:textColor="@color/text_secondary" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/optionLaunch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:text="Launch BGMI"
        android:fontFamily="@font/bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:textColor="@color/on_accent"
        android:background="@drawable/loader_button" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/optionCopyObb"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Copy OBB file"
        android:fontFamily="@font/bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:textColor="@color/text_secondary"
        android:background="@drawable/loader_button_outline" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/optionClearLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Clear login data"
        android:fontFamily="@font/bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:textColor="@color/text_secondary"
        android:background="@drawable/loader_button_outline" />

    <TextView
        android:id="@+id/optionClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:text="Cancel"
        android:fontFamily="@font/font"
        android:textSize="13sp"
        android:includeFontPadding="false"
        android:textColor="@color/text_muted"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>
