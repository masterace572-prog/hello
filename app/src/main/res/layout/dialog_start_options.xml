<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/loader_card_highlight"
    android:padding="22dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="START OPTIONS"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose an action for your BGMI session"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="18dp" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/optionLaunch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="LAUNCH BGMI"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:background="@drawable/loader_button" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/optionCopyObb"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="COPY OBB FILE"
        android:textAllCaps="true"
        android:textColor="@color/secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:background="@drawable/loader_button_outline" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/optionClearLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="CLEAR LOGIN DATA"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:background="@drawable/loader_input" />
    <TextView
        android:id="@+id/optionClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="CANCEL"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:padding="12dp"
        android:layout_marginTop="7dp" />
</LinearLayout>
