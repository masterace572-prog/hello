<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/loader_card_highlight">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_logo_tile"
        android:padding="5dp">

        <ImageView
            android:id="@+id/loadingIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher"
            android:padding="10dp"
            android:contentDescription="Loading" />
    </FrameLayout>

    <TextView
        android:id="@+id/loadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Logging in..."
        style="@style/AppText.Title"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="190dp"
        android:layout_height="6dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:progressTint="@color/primary"
        android:indeterminateTint="@color/primary" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Please wait..."
        style="@style/AppText.Caption"
        android:textColor="@color/text_secondary" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/okButton"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:text="OK"
        android:fontFamily="@font/bold"
        android:textSize="14sp"
        android:textColor="@color/on_accent"
        android:background="@drawable/loader_button"
        android:visibility="gone" />
</LinearLayout>
