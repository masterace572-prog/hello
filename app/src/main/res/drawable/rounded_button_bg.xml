<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient for premium look -->
    <gradient
        android:startColor="#3F51B5"
        android:endColor="#5C6BC0"
        android:angle="0"/>

    <!-- Rounded corners -->
    <corners android:radius="14dp"/>

    <!-- Inner padding feel -->
    <padding
        android:left="10dp"
        android:right="10dp"
        android:top="6dp"
        android:bottom="6dp"/>

</shape>