<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Background -->
    <solid android:color="#EEEEEE"/>

    <!-- Size -->
    <size
        android:width="100dp"
        android:height="100dp"/>

    <!-- Soft border for depth -->
    <stroke
        android:width="2dp"
        android:color="#10FFFFFF"/>

    <!-- Inner spacing -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>

</shape>