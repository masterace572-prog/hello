diff --git a/web/api/admin/upload.js b/web/api/admin/upload.js
new file mode 100644
index 0000000..1070a63
--- /dev/null
+++ b/web/api/admin/upload.js
@@ -0,0 +1,110 @@
+"use strict";
+
+/**
+ * Admin upload -> Supabase Storage (public bucket "viper-updates").
+ * Body is the raw file (application/octet-stream). x-type = "lib" | "app".
+ *
+ * NOTE: Vercel serverless functions have a ~4.5 MB request body limit.
+ * For bigger files, upload in the Supabase dashboard (Storage -> bucket)
+ * and paste the public URL in the admin panel instead.
+ */
+
+const auth = require("../_lib/auth");
+const store = require("../_lib/store");
+
+const MAX_BYTES = 4 * 1024 * 1024; // 4 MB safe limit for Vercel
+const BUCKET = "viper-updates";
+
+function supabaseConfig() {
+  const url = process.env.SUPABASE_URL;
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.SUPABASE_ANON_KEY;
+  if (!url || !key) return null;
+  return { url: url.replace(/\/+$/, ""), key };
+}
+
+async function ensureBucket(cfg) {
+  const res = await fetch(`${cfg.url}/storage/v1/bucket`, {
+    method: "POST",
+    headers: {
+      apikey: cfg.key,
+      Authorization: `Bearer ${cfg.key}`,
+      "Content-Type": "application/json"
+    },
+    body: JSON.stringify({ id: BUCKET, name: BUCKET, public: true })
+  });
+  // 409 = already exists, fine; anything else unexpected -> still continue
+  if (res.status !== 200 && res.status !== 201 && res.status !== 409) {
+    const text = await res.text().catch(() => "");
+    throw new Error("Could not create storage bucket: " + text.slice(0, 120));
+  }
+}
+
+module.exports = async function handler(req, res) {
+  if (!auth.requireAuth(req, res)) return;
+  if (req.method !== "POST") {
+    auth.json(res, 405, { ok: false, error: "Method not allowed." });
+    return;
+  }
+
+  const cfg = supabaseConfig();
+  if (!cfg) {
+    auth.json(res, 400, {
+      ok: false,
+      error: "Supabase Storage is not configured. Add SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, or paste a public URL instead."
+    });
+    return;
+  }
+
+  const type = String(req.headers["x-type"] || "lib");
+  if (type !== "lib" && type !== "app") {
+    auth.json(res, 400, { ok: false, error: "x-type must be 'lib' or 'app'." });
+    return;
+  }
+
+  let raw;
+  try {
+    raw = await auth.readRawBody(req, MAX_BYTES + 1024);
+  } catch (err) {
+    auth.json(res, 413, { ok: false, error: "Upload too large." });
+    return;
+  }
+
+  const size = raw.length;
+  if (size === 0) {
+    auth.json(res, 400, { ok: false, error: "Empty file." });
+    return;
+  }
+  if (size > MAX_BYTES) {
+    auth.json(res, 413, {
+      ok: false,
+      error: "File is larger than 4 MB. Upload it in the Supabase dashboard (Storage) and paste the public URL here."
+    });
+    return;
+  }
+
+  const name = String(req.headers["x-file-name"] || "file").replace(/[^a-zA-Z0-9._-]/g, "_").slice(0, 120);
+  const folder = type === "lib" ? "libs" : "apps";
+  const path = `${folder}/${Date.now()}-${name}`;
+
+  try {
+    await ensureBucket(cfg);
+    const upload = await fetch(`${cfg.url}/storage/v1/object/${BUCKET}/${path}`, {
+      method: "POST",
+      headers: {
+        apikey: cfg.key,
+        Authorization: `Bearer ${cfg.key}`,
+        "Content-Type": "application/octet-stream",
+        "x-upsert": "true"
+      },
+      body: raw
+    });
+    if (!upload.ok) {
+      const text = await upload.text().catch(() => "");
+      throw new Error("Storage upload failed: " + text.slice(0, 120));
+    }
+    const publicUrl = `${cfg.url}/storage/v1/object/public/${BUCKET}/${path}`;
+    auth.json(res, 200, { ok: true, url: publicUrl, size });
+  } catch (err) {
+    auth.json(res, 500, { ok: false, error: "Upload failed: " + err.message });
+  }
+};
